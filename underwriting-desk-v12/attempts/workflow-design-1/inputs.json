          "text": "Declined deals require a documented adverse-action reason captured at the time of decline.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src_intake",
            "claim": "c026"
          }
        },
        {
          "id": "R-027",
          "text": "Record every deal state change in an immutable audit trail.",
          "category": "data",
          "confidence": "stated",
          "provenance": {
            "source": "src_intake",
            "claim": "c027"
          }
        },
        {
          "id": "R-028",
          "text": "Record every ratio calculation, including its inputs and result, in an immutable audit trail.",
          "category": "data",
          "confidence": "stated",
          "provenance": {
            "source": "src_intake",
            "claim": "c028"
          }
        },
        {
          "id": "R-029",
          "text": "Record every agent draft in an immutable audit trail.",
