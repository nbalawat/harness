          "text": "Implement exactly five distinct AI agents operating inside the workflow, each constrained to a narrow mandate rather than one general-purpose agent.",
          "category": "agent",
          "confidence": "stated",
          "provenance": {
            "source": "src_intake",
            "claim": "c004"
          }
        },
        {
