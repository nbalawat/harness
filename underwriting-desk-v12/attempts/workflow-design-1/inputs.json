            "claim": "c020"
          }
        },
        {
          "id": "R-021",
          "text": "Tier approval authority by exposure amount: a senior credit officer may approve deals up to $1,000,000.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src_intake",
            "claim": "c021"
          }
        },
        {
          "id": "R-022",
          "text": "Tier approval authority by exposure amount: deals above $1,000,000 must be approved by a credit committee.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src_intake",
            "claim": "c022"
          }
        },
        {
          "id": "R-023",
          "text": "No agent may approve a deal, decline a deal, or advance a deal past an approval step; this must be enforced as a hard system guardrail, not a prompt instruction.",
          "category": "security",
