          "confidence": "stated",
          "provenance": {
            "source": "src_intake",
            "claim": "c001"
          }
        },
        {
          "id": "R-002",
          "text": "Run the underwriting pipeline as an explicit multi-stage workflow with the ordered stages: intake, document extraction, financial spreading, risk grading, memo drafting, policy compliance check, tiered approval, closing.",
