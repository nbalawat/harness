{
  "slices": [
    {
      "id": "deal-intake-and-triage",
      "name": "Deal intake, triage agent, and pipeline board",
      "story": "As a relationship manager I submit an SMB loan request and it becomes a tracked deal; the Intake Triage Agent classifies it, flags the documents still missing, and recommends an analyst queue, and after an analyst explicitly accepts that proposal the deal is routed and visible to everyone on the pipeline board grouped by workflow stage.",
      "addresses": [
        "R-001",
        "R-002",
        "R-003",
        "R-004",
        "R-005",
        "R-006",
        "R-007",
        "R-025",
        "R-027",
        "R-031",
        "R-032",
        "R-036",
        "R-039",
        "R-040",
        "R-041",
        "R-046",
        "R-048",
        "R-053",
        "R-055",
        "R-056",
        "R-058",
        "R-060",
        "R-064",
        "R-065",
        "R-066",
        "R-067"
      ],
      "covers": [
        "screen-pipeline-board"
      ],
      "acceptance": [
        {
          "method": "POST",
          "path": "/api/deals",
          "body": {
            "borrower_name": "Harborline Freight",
            "borrower_industry": "trucking",
            "requested_amount": 400000,
            "exposure_amount": 400000,
            "acting_user_email": "rm@bank.test"
          },
          "expect_status": 201,
          "expect_contains": [
            "Harborline Freight",
            "intake"
          ]
        },
        {
          "method": "GET",
          "path": "/api/pipeline",
          "expect_status": 200,
          "expect_contains": [
            "intake",
            "Harborline Freight"
          ]
        },
        {
          "method": "POST",
          "path": "/api/deals/DEAL-1001/agents/intake-triage/run",
          "body": {
            "acting_user_email": "analyst@bank.test"
          },
          "expect_status": 200,
          "expect_contains": [
            "classification",
            "missing_documents",
            "recommended_queue",
            "confidence_score"
          ]
        },
        {
          "method": "POST",
          "path": "/api/deals/DEAL-1001/triage/accept",
          "body": {
            "acting_user_email": "analyst@bank.test"
          },
          "expect_status": 200,
          "expect_contains": [
            "document_extraction",
            "queue"
          ]
        }
      ]
    },
    {
      "id": "spread-ratios-and-risk-grade",
      "name": "Cited financial spread, deterministic ratios, and risk grade",
      "story": "As a credit analyst I open a deal dossier, run the Financial Spreading Agent to fill the standard spread template with a document-and-locator citation on every figure, accept or edit the draft, and the system then computes DSCR, leverage, and current ratio in deterministic code and assigns the risk grade from the versioned rubric, showing the exact band hit.",
      "addresses": [
        "R-008",
        "R-009",
        "R-016",
        "R-017",
        "R-018",
        "R-019",
        "R-025",
        "R-028",
        "R-029",
        "R-035",
        "R-042",
        "R-043",
        "R-045",
        "R-049",
        "R-061",
        "R-064",
        "R-070"
      ],
      "covers": [
        "screen-deal-detail"
      ],
      "acceptance": [
        {
          "method": "POST",
          "path": "/api/deals/DEAL-1002/agents/financial-spreading/run",
          "body": {
            "acting_user_email": "analyst@bank.test"
          },
          "expect_status": 200,
          "expect_contains": [
            "rows",
            "citations",
            "template_version",
            "document_id"
          ]
        },
        {
          "method": "POST",
          "path": "/api/deals/DEAL-1002/spread/accept",
          "body": {
            "acting_user_email": "analyst@bank.test",
            "action": "accept"
          },
          "expect_status": 200,
          "expect_contains": [
            "accepted",
            "analyst@bank.test"
          ]
        },
        {
          "method": "GET",
          "path": "/api/deals/DEAL-1002/ratios",
          "expect_status": 200,
          "expect_contains": [
            "dscr",
            "leverage",
            "current_ratio",
            "numerator",
            "denominator"
          ]
        },
        {
          "method": "GET",
          "path": "/api/deals/DEAL-1002/risk-grade",
          "expect_status": 200,
          "expect_contains": [
            "grade",
            "rubric_version",
            "band_hit"
          ]
        }
      ]
    },
    {
      "id": "memo-policy-and-audit-trail",
      "name": "Credit memo, policy exceptions, and the per-deal chronicle",
      "story": "As a credit analyst I run the Credit Memo Agent to draft the memo citing the ratios, spread lines, and policy rules it relied on, then the Policy Compliance Agent tests the deal against the active lending ruleset and writes an exception for every breach; as a reviewer I read the whole history — state changes, ratio calculations, agent drafts, and human acceptances — in order on the deal's audit timeline.",
      "addresses": [
        "R-010",
        "R-011",
        "R-012",
        "R-013",
        "R-025",
        "R-027",
        "R-029",
        "R-030",
        "R-043",
        "R-044",
        "R-049",
        "R-050",
        "R-051",
        "R-052",
        "R-055",
        "R-056"
      ],
      "covers": [
        "screen-audit-timeline"
      ],
      "acceptance": [
        {
          "method": "POST",
          "path": "/api/deals/DEAL-1003/agents/credit-memo/run",
          "body": {
            "acting_user_email": "analyst@bank.test"
          },
          "expect_status": 200,
          "expect_contains": [
            "memo_content",
            "citations",
            "sections"
          ]
        },
        {
          "method": "POST",
          "path": "/api/deals/DEAL-1003/agents/policy-compliance/run",
          "body": {
            "acting_user_email": "analyst@bank.test"
          },
          "expect_status": 200,
          "expect_contains": [
            "findings",
