{
  "type": "object",
  "properties": {
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 10 },
          "addresses": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "kind": { "enum": ["deterministic", "agent", "human", "condition"] },
                "handler": { "type": "string" },
                "prompt": { "type": "string" },
                "question": { "type": "string" },
                "path": { "type": "string" },
                "equals": {},
                "on_false": { "type": "string" },
                "output_schema": { "type": "object" }
              },
              "required": ["id", "kind"]
            }
          }
        },
        "required": ["name", "description", "addresses", "nodes"]
      }
    }
  },
  "required": ["workflows"]
}
