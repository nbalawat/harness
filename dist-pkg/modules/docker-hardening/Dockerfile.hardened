# Hardened reference image for generated apps (see agent-guide).
FROM python:3.12.8-slim
WORKDIR /app
COPY backend/ backend/
COPY agents/ agents/
RUN pip install --no-cache-dir -r backend/requirements.txt \
 && useradd --create-home appuser
USER appuser
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "--app-dir", "backend", "main:app", "--host", "0.0.0.0", "--port", "8000"]
