{
  "requirements": {
    "path": "/Users/nbalawat/development/harness/commercialbanking/artifacts/requirements-synthesis/requirements.json",
    "data": {
      "requirements": [
        {
          "id": "REQ-001",
          "text": "The system must model underwriting as an explicit, ordered multi-stage workflow with these stages: intake, document extraction, financial spreading, risk grading, memo drafting, policy compliance check, tiered approval, closing.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-001"
          }
        },
        {
          "id": "REQ-002",
          "text": "Each deal must carry an explicit current-stage value, and stage transitions must be constrained so a deal can only advance along the defined workflow order (or be returned to an earlier stage for rework).",
          "category": "functional",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-003",
          "text": "A pipeline board must display every active deal with its current stage and stage status, so users can see where each deal stands at a glance.",
          "category": "ux",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-002"
          }
        },
        {
          "id": "REQ-004",
          "text": "Intake and document extraction must accept the formats applications currently arrive in: email content and spreadsheet files.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-027"
          }
        },
        {
          "id": "REQ-005",
          "text": "The system must store uploaded source artifacts (emails, spreadsheets, financial statements) per deal and retain them for later citation and audit.",
          "category": "data",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-006",
          "text": "An intake triage agent must classify each incoming request (e.g. request type / product / suitability for underwriting).",
          "category": "agent",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-003"
          }
        },
        {
          "id": "REQ-007",
          "text": "The intake triage agent must identify and flag missing required documents on an incoming request.",
          "category": "agent",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-004"
          }
        },
        {
          "id": "REQ-008",
          "text": "The intake triage agent must recommend routing of each request to the correct analyst queue.",
          "category": "agent",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-005"
          }
        },
        {
          "id": "REQ-009",
          "text": "The system must maintain analyst work queues that deals can be routed into and worked from.",
          "category": "functional",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-010",
          "text": "A financial spreading agent must extract figures from borrower financial statements into a standard spread template.",
          "category": "agent",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-006"
          }
        },
        {
          "id": "REQ-011",
          "text": "The financial spreading agent must attach a source reference to every extracted number, showing where in the borrower's statements the figure came from.",
          "category": "agent",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-007"
          }
        },
        {
          "id": "REQ-012",
          "text": "The standard spread template must be a defined, structured schema of line items so spreads are consistent across deals and machine-readable by the ratio engine.",
          "category": "data",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-013",
          "text": "Every spread line item must persist its provenance (source document, location within the document, and extracted raw value) alongside the accepted value.",
          "category": "data",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-014",
          "text": "Deterministic, non-agent logic must compute the credit ratios DSCR, leverage, and current ratio from the accepted spread.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-013"
          }
        },
        {
          "id": "REQ-015",
          "text": "Deterministic, non-agent logic must assign the risk grade from a transparent, inspectable rubric.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-014"
          }
        },
        {
          "id": "REQ-016",
          "text": "Ratio and risk-grade computations must be reproducible and explainable: the system must be able to show the inputs, the formula/rubric rule applied, and the resulting value.",
          "category": "functional",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-017",
          "text": "The specific risk-grading rubric — grade scale, the ratio/qualitative thresholds, and how they map to a grade — is not defined in the evidence and must be supplied before grading can be implemented as intended.",
          "category": "functional",
          "confidence": "unknown"
        },
        {
          "id": "REQ-018",
          "text": "A credit memo agent must draft the underwriting memo for a deal.",
          "category": "agent",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-008"
          }
        },
        {
          "id": "REQ-019",
          "text": "The credit memo draft must cite the specific ratios, spread figures, and policy rules it relied on, with those citations traceable back to the stored values.",
          "category": "agent",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-008"
          }
        },
        {
          "id": "REQ-020",
          "text": "A policy compliance agent must review every drafted memo against lending policy, covering at minimum concentration limits, prohibited industries, and loan-to-value caps.",
          "category": "agent",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-009"
          }
        },
        {
          "id": "REQ-021",
          "text": "The policy compliance agent must raise written exceptions describing each policy violation it finds.",
          "category": "agent",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-010"
          }
        },
        {
          "id": "REQ-022",
          "text": "Lending policy rules (concentration limits, prohibited industry list, loan-to-value caps) must be stored as configurable, versioned data rather than hard-coded, and the system must ship with a documented default rule set since no bank policy document was supplied.",
          "category": "data",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-023",
          "text": "Concentration-limit evaluation must aggregate across the active portfolio (not just the deal under review), so the system must support portfolio-level exposure aggregation by the relevant dimensions.",
          "category": "functional",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-024",
          "text": "Policy exceptions must be persisted on the deal with their status (open, accepted/waived, resolved) and the named human who dispositioned them.",
          "category": "data",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-025",
          "text": "A portfolio Q&A agent must let credit officers ask natural-language questions across active deals, such as \"show me all deals above $500k with DSCR under 1.2\".",
          "category": "agent",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-011"
          }
        },
        {
          "id": "REQ-026",
          "text": "Portfolio Q&A answers must be grounded in stored deal data and must not assert figures that are not retrievable from that data.",
          "category": "agent",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-012"
          }
        },
        {
          "id": "REQ-027",
          "text": "The portfolio Q&A agent must be read-only: it may query deal data but may not mutate deals, stages, or decisions.",
          "category": "security",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-028",
          "text": "Portfolio Q&A results must respect the asking user's role-based visibility scope, so a user cannot see deals through Q&A that they could not see directly.",
          "category": "security",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-029",
          "text": "Each agent must operate under a narrow mandate limited to its stage; agents must not perform work assigned to another agent or to deterministic logic.",
          "category": "agent",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-030",
          "text": "All agent output must be persisted as a proposal/draft in a pending state that is distinct from accepted deal data, and only human-accepted output may feed downstream stages.",
          "category": "agent",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-031",
          "text": "Approvals must be tiered by exposure: a credit analyst may approve deals up to $250k.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-015"
          }
        },
        {
          "id": "REQ-032",
          "text": "Approvals must be tiered by exposure: a senior credit officer may approve deals up to $1M.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-016"
          }
        },
        {
          "id": "REQ-033",
          "text": "Approvals must be tiered by exposure: deals above $1M must be approved by a credit committee.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-017"
          }
        },
        {
          "id": "REQ-034",
          "text": "The system must derive the required approval tier from the deal's exposure amount and refuse an approval submitted by a user whose authority level is below that tier.",
          "category": "security",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-035",
          "text": "Credit-committee approval mechanics for deals above $1M are undefined: whether it requires a quorum of multiple named approvers, a recorded committee vote, or a single chair recording the committee's decision. This changes the approval data model and UI.",
          "category": "functional",
          "confidence": "unknown"
        },
        {
          "id": "REQ-036",
          "text": "No agent may approve, decline, or advance a deal past an approval step; approval-step transitions must be executable only by an authenticated human.",
          "category": "security",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-018"
          }
        },
        {
          "id": "REQ-037",
          "text": "A named human decision is mandatory at each approval step, and the decision record must identify that person.",
          "category": "security",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-019"
          }
        },
        {
          "id": "REQ-038",
          "text": "Every agent output — triage, spread, memo, and compliance exceptions — requires explicit human acceptance before the workflow proceeds to the next stage.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-020"
          }
        },
        {
          "id": "REQ-039",
          "text": "Human reviewers must be able to edit or reject agent output as well as accept it, with the edited/accepted value becoming the system of record and the original draft retained.",
          "category": "functional",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-040",
          "text": "Declined deals must require a documented adverse-action reason recorded with the decline decision.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-021"
          }
        },
        {
          "id": "REQ-041",
          "text": "Credit officers must be able to return a deal for rework, sending it back to an earlier stage with a reason and an assignee.",
          "category": "functional",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-025"
          }
        },
        {
          "id": "REQ-042",
          "text": "Every state change, ratio calculation, agent draft, and human decision must be written to an immutable audit trail.",
          "category": "data",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-022"
          }
        },
        {
          "id": "REQ-043",
          "text": "The audit trail must be append-only — no update or delete path may be exposed to any user, role, or agent — and each entry must record actor identity, actor type (human or agent), timestamp, deal, event type, and before/after values where applicable.",
          "category": "security",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-044",
          "text": "The audit trail for a deal must be viewable in the UI as a chronological history.",
          "category": "ux",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-045",
          "text": "Role-based access control must define a relationship manager role that may submit deals and view only its own deals.",
          "category": "security",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-023"
          }
        },
        {
          "id": "REQ-046",
          "text": "Role-based access control must define a credit analyst role that may spread financials, draft memos, and recommend decisions.",
          "category": "security",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-024"
          }
        },
        {
          "id": "REQ-047",
          "text": "Role-based access control must define a credit officer role that may approve, decline, or return deals for rework.",
          "category": "security",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-025"
          }
        },
        {
          "id": "REQ-048",
          "text": "Relationship manager visibility must be enforced as row-level scoping at the data-access layer, not merely hidden in the UI, and must apply to list views, deal detail, search, and Q&A alike.",
          "category": "security",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-049",
          "text": "Users must authenticate with a persistent named identity, since decisions, acceptances, and audit entries must be attributable to a specific person.",
          "category": "security",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-050",
          "text": "Borrower financial data and application documents must be treated as sensitive: not written to logs or agent telemetry in raw form, and accessible only to users whose role and scope permit it.",
          "category": "security",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-051",
          "text": "An SLA dashboard must surface deals that have been idle past 5 business days.",
          "category": "ops",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-026"
          }
        },
        {
          "id": "REQ-052",
          "text": "The system must track a last-activity timestamp per deal and compute idle age using business days (excluding weekends) to drive the SLA dashboard.",
          "category": "data",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-053",
          "text": "Supervision is gates-only: human approval gates are enforced at the defined checkpoints (agent-output acceptance and approval steps) rather than through continuous human supervision of agent execution.",
          "category": "ops",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-029"
          }
        },
        {
          "id": "REQ-054",
          "text": "The system must be deployable and runnable on a local target, with no dependency on managed cloud infrastructure for core operation.",
          "category": "ops",
          "confidence": "stated",
          "provenance": {
            "source": "src-intake",
            "claim": "C-028"
          }
        },
        {
          "id": "REQ-055",
          "text": "Because no supporting documents were supplied, the system must ship with synthetic seed data — sample deals, borrower statements, users in each role, and a default policy rule set — sufficient to demonstrate the full pipeline end to end.",
          "category": "data",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-056",
          "text": "A deal record must be the central entity, holding borrower identity, requested exposure amount, industry, collateral/LTV inputs, current stage, assigned owner, spread, computed ratios, risk grade, memo, exceptions, and decision history.",
          "category": "data",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-057",
          "text": "Each stage must expose a review workspace showing the agent's draft output side by side with its cited sources, so a human can verify before accepting.",
          "category": "ux",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-058",
          "text": "The spread view must let a reviewer drill from any figure to the source reference the spreading agent recorded for it.",
          "category": "ux",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-059",
          "text": "The portfolio Q&A agent must be reachable through a conversational query interface that displays the supporting deal records behind each answer.",
          "category": "ux",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-060",
          "text": "Navigation and available actions must adapt to the signed-in user's role, so each role sees only the deals and controls its permissions allow.",
          "category": "ux",
          "confidence": "inferred",
          "provenance": {
            "source": "src-intake"
          }
        },
        {
          "id": "REQ-061",
          "text": "How email applications enter the system is undefined: whether the system connects to a live mailbox (IMAP/API polling) and ingests automatically, or whether a user manually uploads exported email files and attachments. This materially changes intake architecture.",
          "category": "functional",
          "confidence": "unknown"
        },
        {
          "id": "REQ-062",
          "text": "The scope of the final closing stage is undefined: whether it involves generating closing documents, recording funding/booking to a core system, or is simply a terminal status after approval.",
          "category": "functional",
          "confidence": "unknown"
        }
      ]
    }
  },
