    {
      "id": "deterministic-risk-scoring",
      "name": "Deterministic risk scoring and banding",
      "story": "As a KYC analyst, when a case passes completeness it is scored mechanically from the risk rating matrix — five weighted factors, a Low/Medium/High band, and a forced High band whenever sanctions screening returns a true positive — and I can open a score breakdown showing every factor's input, raw score, weight and contribution, so I can verify the arithmetic without ever being able to edit the score. Representative seeded cases SEED-LOW-001 (Cobalt Foods Ltd), SEED-MED-002 (Harbour Freight SA) and SEED-HIGH-003 (Meridian Exchange Ltd) exist for each band.",
      "addresses": [
        "REQ-016",
        "REQ-017",
        "REQ-018",
        "REQ-019",
        "REQ-020",
        "REQ-021",
        "REQ-022",
        "REQ-023",
        "REQ-024",
        "REQ-025",
        "REQ-026",
        "REQ-027",
        "REQ-028",
        "REQ-071",
        "REQ-091"
      ],
      "acceptance": [
        {
          "method": "POST",
          "path": "/cases",
          "body": {
            "client_name": "Osprey Gaming NV",
            "entity_type": "corporate",
            "ownership_chain_depth": 1,
            "regulated_industry": true,
            "cross_border_expected": false,
            "documents": [
              "certificate_of_incorporation",
              "register_of_directors",
              "beneficial_ownership_declaration",
              "proof_of_registered_address",
              "operating_license"
            ],
            "risk_factors": {
              "jurisdiction": "fatf_high_risk",
              "entity_structure": "nominee_shareholders",
              "industry": "gambling",
              "sanctions_screening": "clear",
              "expected_activity": "domestic_only"
            }
          },
          "expect_status": 200,
          "expect_contains": ["Osprey Gaming NV", "total_risk_score", "60", "Medium"]
        },
        {
          "method": "POST",
          "path": "/cases",
