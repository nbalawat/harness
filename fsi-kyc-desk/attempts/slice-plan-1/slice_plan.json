  "slices": [
    {
      "id": "case-intake-completeness",
      "name": "Case intake and deterministic completeness gate",
      "story": "As a KYC analyst, I open a case from a client submission and its document package, and a purely mechanical completeness check either marks the case READY for review or RETURNS it with the itemized list of missing documents — so no review ever starts on an incomplete file and the client can be told exactly what to resupply. The case worklist screen shows every case with its status, and each intake action lands in the append-only audit trail with the policy versions that applied.",
      "addresses": [
        "REQ-001",
        "REQ-002",
        "REQ-003",
        "REQ-004",
        "REQ-005",
        "REQ-006",
        "REQ-007",
        "REQ-008",
        "REQ-009",
        "REQ-010",
        "REQ-011",
        "REQ-012",
        "REQ-013",
        "REQ-014",
        "REQ-055",
        "REQ-064",
        "REQ-065",
        "REQ-066",
        "REQ-067",
        "REQ-070",
        "REQ-089",
        "REQ-094"
