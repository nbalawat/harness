{
  "proven_through_slice": 4,
  "slices": [
    {
      "slice": "case-intake-completeness",
      "name": "Case intake and deterministic completeness check",
      "objective": "As a KYC analyst, I submit a client's onboarding package so that a case is opened and mechanically checked against the Document Checklist: a complete package moves the case to READY with a case-ready timestamp, an incomplete package is RETURNED with the itemized list of exactly which documents are missing, and no analyst can waive a required item. Cases are addressed by their submission reference; the worklist and case detail screens show status and the missing-document list.",
      "addresses": [
        "REQ-001",
        "REQ-002",
        "REQ-003",
        "REQ-004",
        "REQ-005",
        "REQ-006",
        "REQ-007",
        "REQ-008",
        "REQ-009",
        "REQ-010",
        "REQ-011",
        "REQ-012",
        "REQ-013",
        "REQ-014",
        "REQ-055",
        "REQ-070",
        "REQ-089",
        "REQ-094"
      ],
      "checks": [
        {
          "method": "POST",
          "path": "/cases",
          "expected_status": 200,
          "contains": [
            "acc-complete-001",
            "\"status\":\"ready\"",
            "case_ready_timestamp",
            "document_checklist_version"
          ],
          "ok": true
        },
        {
          "method": "POST",
          "path": "/cases",
          "expected_status": 200,
          "contains": [
            "\"status\":\"returned\"",
            "missing_documents",
            "register_of_directors",
            "beneficial_ownership_declaration",
            "structure_chart",
            "operating_license"
          ],
          "ok": true
        },
        {
          "method": "POST",
          "path": "/cases",
          "expected_status": 200,
          "contains": [
            "\"status\":\"returned\"",
            "expected_activity_questionnaire"
          ],
          "ok": true
        },
        {
          "method": "GET",
          "path": "/cases",
          "expected_status": 200,
          "contains": [
            "acc-complete-001",
            "acc-returned-001",
            "\"status\":\"returned\""
          ],
          "ok": true
        },
        {
          "method": "GET",
          "path": "/cases/ACC-RETURNED-001",
          "expected_status": 200,
          "contains": [
            "\"status\":\"returned\"",
            "missing_documents",
            "register_of_directors"
          ],
          "ok": true
        },
        {
          "method": "POST",
