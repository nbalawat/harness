{
  "type": "object",
  "properties": {
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "addresses": { "type": "array", "items": { "type": "string" } },
          "access": { "enum": ["open", "read"], "description": "Generic /api/{table} exposure: open = read+write, read = read-only. Absent = closed (explicit endpoints only) — the default for anything sensitive." },
          "name": { "type": "string", "pattern": "^[a-z_]+$" },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": { "name": { "type": "string" }, "type": { "type": "string" } },
              "required": ["name", "type"]
            }
          }
        },
        "required": ["name", "columns", "addresses"]
      }
    }
  },
  "required": ["tables"]
}
