{
  "type": "object",
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string", "minLength": 5 },
          "category": { "enum": ["functional", "ux", "data", "security", "agent", "ops"] },
          "confidence": { "enum": ["stated", "inferred", "unknown"] },
          "provenance": {
            "type": "object",
            "properties": {
              "source": { "type": "string" },
              "claim": { "type": "string" }
            },
            "required": ["source"]
          }
        },
        "required": ["id", "text", "category", "confidence"],
        "if": { "properties": { "confidence": { "const": "stated" } } },
        "then": { "required": ["id", "text", "category", "confidence", "provenance"] }
      }
    }
  },
  "required": ["requirements"]
}
