{
  "type": "object",
  "properties": {
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["persistence-core", "chat-shell", "agent-runtime"] }
    },
    "deploy_target": { "enum": ["local", "cloud-run"] },
    "build_budget_plan": {
      "type": "object",
      "properties": {
        "nodes": { "type": "object" },
        "total_usd": { "type": "number", "minimum": 0 }
      },
      "required": ["nodes", "total_usd"]
    }
  },
  "required": ["modules", "deploy_target", "build_budget_plan"]
}
